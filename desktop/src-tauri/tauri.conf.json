{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Bodega",
	"version": "0.2.0",
	"identifier": "com.reydavidag.bodega",
	"build": {
		"frontendDist": "../fallback"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app"],
		"category": "DeveloperTool",
		"copyright": "MIT",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.png"
		],
		"macOS": {
			"minimumSystemVersion": "13.0"
		}
	}
}
