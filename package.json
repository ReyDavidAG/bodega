{
	"name": "bodega",
	"version": "0.2.0",
	"description": "Administra el espacio de tu Mac de desarrollo: compilados, cachés, simuladores, puertos abiertos, discos externos y respaldo cifrado de llaves.",
	"license": "MIT",
	"type": "module",
	"private": true,
	"bin": {
		"bodega": "bin/bodega.js"
	},
	"engines": {
		"node": ">=22.18"
	},
	"os": [
		"darwin"
	],
	"scripts": {
		"start": "node src/cli/main.ts serve",
		"dev": "node --watch src/cli/main.ts serve & vite --config web/vite.config.ts",
		"build": "tsc -p tsconfig.json --noEmit && vite build --config web/vite.config.ts",
		"desktop:dev": "tauri dev --config desktop/src-tauri/tauri.conf.json",
		"desktop:build": "tauri build --config desktop/src-tauri/tauri.conf.json",
		"test": "node --test test/*.test.ts",
		"lint": "eslint src web/src test",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@tanstack/react-query": "5.101.2",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-router": "8.3.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "9.39.1",
		"@tauri-apps/cli": "2.12.4",
		"@types/node": "24.10.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@typescript-eslint/eslint-plugin": "8.53.0",
		"@typescript-eslint/parser": "8.53.0",
		"@vitejs/plugin-react": "5.1.1",
		"eslint": "9.39.1",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"eslint-plugin-simple-import-sort": "12.1.1",
		"globals": "16.5.0",
		"prettier": "3.7.4",
		"typescript": "5.9.3",
		"typescript-eslint": "8.46.4",
		"vite": "7.3.7"
	},
	"overrides": {
		"esbuild": "0.28.1",
		"brace-expansion": "2.1.7"
	}
}
